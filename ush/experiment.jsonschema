{
  "additionalProperties": true,
  "properties": {
    "platform": {
      "additionalProperties": true,
      "properties": {
        "NCORES_PER_NODE": {
          "minimum": 1,
          "type": "integer"
        },
        "SCHED": {
          "enum": [
            "lsf",
            "lsfcray",
            "none",
            "pbspro",
            "slurm"
          ],
          "type": "string"
        },
        "WORKFLOW_MANAGER": {
          "enum": [
            "ecflow",
            "none",
            "rocoto"
          ],
          "type": "string"
        }
      },
      "required": [
        "NCORES_PER_NODE"
      ],
      "type": "object"
    },
    "user": {
      "additionalProperties": true,
      "properties": {
        "MACHINE": {
          "enum": [
            "DERECHO",
            "HERA",
            "HERCULES",
            "JET",
            "LINUX",
            "MACOS",
            "NOAACLOUD",
            "ORION",
            "SINGULARITY",
            "URSA",
            "WCOSS2"
          ],
          "type": "string"
        }
      }
    },
    "verification": {
      "additionalProperties": true,
      "properties": {
        "FCST_SMOKE_TYPE": {
          "enum": [
            "HRRR",
            "RRFS"
          ],
          "type": "string"
        },
        "VX_APCP_ACCUMS_HRS": {
          "prefixItems": [
            {
              "enum": [
                1,
                3,
                6,
                24
              ]
            },
            {
              "type": "integer"
            }
          ],
          "type": "array"
        },
        "VX_ASNOW_ACCUMS_HRS": {
          "prefixItems": [
            {
              "enum": [
                6,
                12,
                18,
                24
              ]
            },
            {
              "type": "integer"
            }
          ],
          "type": "array"
        },
        "VX_FIELD_GROUPS": {
          "prefixItems": [
            { "enum": [
              "AOD",
              "APCP",
              "ASNOW",
              "GOESADP",
              "GOESAOD",
              "PM10",
              "PM25",
              "REFC",
              "RETOP",
              "SFC",
              "UPA"
              ]
            }
          ],
          "type": "array"
        },
        "VX_MASK": {
          "prefixItems": [
            { "enum": [
              "APL",
              "ATC",
              "AZCA",
              "CAM",
              "CAR",
              "CONUS",
              "EAST",
              "EAST_OF_ROCKIES",
              "ECA",
              "GLF",
              "GMC",
              "GRB",
              "HWI",
              "LMV",
              "MDW",
              "MEX",
              "NAK",
              "NAO",
              "NEC",
              "NMT",
              "NPL",
              "NSA",
              "NWC",
              "PRI",
              "SAO",
              "SEC",
              "SMT",
              "SPL",
              "SWC",
              "SWD",
              "WCA",
              "WEST"
              ]
            }
          ],
          "type": "array"
        }
      }
    },
    "workflow": {
      "additionalProperties": true,
      "properties": {
        "COLDSTART": {
          "type": "boolean"
        },
        "COMPILER": {
          "enum": [
            "intel",
            "gnu"
          ],
          "type": "string"
        },
        "DATE_FIRST_CYCL": {
          "format": "date-time",
          "type": "string"
        },
        "DATE_LAST_CYCL": {
          "format": "date-time",
          "type": "string"
        },
        "DEBUG": {
          "type": "boolean"
        },
        "FCST_MODEL": {
          "enum": [
            "ufs-weather-model"
          ],
          "type": "string"
        },
        "PREEXISTING_DIR_METHOD": {
          "enum": [
            "delete",
            "quit",
            "rename",
            "reuse"
          ],
          "type": "string"
        },
        "VERBOSE": {
          "type": "boolean"
        }
      }
    }
  },
  "type": "object"
}
